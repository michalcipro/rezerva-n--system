# Ostrý provoz. Adresy projektu doplňte v nastavení hostingu (Cloudflare Pages → Settings → Environment variables)
# nebo do souboru .env.prod.local (není v gitu):
#   VITE_API_URL=https://<projekt>.supabase.co/functions/v1/api
#   VITE_SUPABASE_URL=https://<projekt>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<veřejný klíč projektu (anon / publishable)>
VITE_BACKEND=server
