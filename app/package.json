{
  "name": "pohyb-rezervace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite-node server/dev-server.ts",
    "dev:live": "vite --mode live",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/build-artifact.mjs",
    "build:prod": "tsc --noEmit && vite build --mode prod && node scripts/build-legal.mjs",
    "build:edge": "node scripts/build-edge.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "immer": "10.1.1",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.21.5",
    "marked": "18.1.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.9"
  }
}
